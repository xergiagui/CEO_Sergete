  "lineas": [
    {"t0": 8.10,   "t1": 10.50,  "texto": "¡La pesca del día! ¡Tencas!"},
    {"t0": 11.00,  "t1": 13.52,  "texto": "No hace falta que grites, te olemos a la legua."},
    {"t0": 13.68,  "t1": 15.52,  "texto": "¡Cómeme el boquerón, capullo!"},
    {"t0": 16.98,  "t1": 17.90,  "texto": "¿Qué, pescadora?"},
    {"t0": 18.20,  "t1": 19.66,  "texto": "¿Ya te has pillado a un amante?"},
    {"t0": 20.80,  "t1": 23.14,  "texto": "El amor parece más una carga que un premio."},
    {"t0": 24.70,  "t1": 25.40,  "texto": "Perdón."},
    {"t0": 25.70,  "t1": 26.80,  "texto": "Era de mi madre."},
    {"t0": 27.50,  "t1": 30.45,  "texto": "No es ninguna vergüenza pasar el resto de tu vida sola."},
    {"t0": 31.60,  "t1": 33.48,  "texto": "Yo me casaré contigo."},
    {"t0": 42.98,  "t1": 44.62,  "texto": "Quiero que me hagas un marido."},
    {"t0": 45.90,  "t1": 47.22,  "texto": "Ve a la capilla en un mes."},
    {"t0": 48.52,  "t1": 49.10,  "texto": "Bien."},
    {"t0": 64.00,  "t1": 65.88,  "texto": "He venido a casarme contigo."},
    {"t0": 67.86,  "t1": 68.98,  "texto": "¿Qué es eso?"},
    {"t0": 69.60,  "t1": 72.34,  "texto": "Este es mi marido."},
    {"t0": 73.30,  "t1": 75.40,  "texto": "Dicen que es fuerte y duro como un árbol."},
    {"t0": 79.70,  "t1": 80.78,  "texto": "Es de mimbre."},
    {"t0": 82.95,  "t1": 84.32,  "texto": "Me ha puesto firme."},
    {"t0": 85.40,  "t1": 88.32,  "texto": "Tú eres la razón por la que vivo y respiro."},
    {"t0": 89.00,  "t1": 89.88,  "texto": "No es natural."},
    {"t0": 90.10,  "t1": 91.64,  "texto": "Los hombres no son así."},
    {"t0": 92.20,  "t1": 93.60,  "texto": "Una sátira elocuente."},
    {"t0": 96.30,  "t1": 98.12,  "texto": "Has causado una gran impresión."},
    {"t0": 98.16,  "t1": 99.64,  "texto": "Todas las esposas están alteradas."},
    {"t0": 99.82,  "t1": 101.22, "texto": "No la culpo, yo me lo montaría."},
    {"t0": 101.42, "t1": 101.95, "texto": "Prima."},
    {"t0": 104.24, "t1": 106.12, "texto": "Estás envalentonada, ¿no, pescadora?"},
    {"t0": 106.30, "t1": 109.42, "texto": "Él tiene sus días, yo los míos, y juntos tenemos nuestras noches."},
    {"t0": 111.98, "t1": 113.20, "texto": "¿Están matando a alguien?"},
    {"t0": 120.78, "t1": 121.90, "texto": "¡Vamos allá!"},
    {"t0": 126.60, "t1": 129.54, "texto": "Voy a arreglar la cama esta tarde."},
    {"t0": 132.80, "t1": 134.40, "texto": "Se ha vuelto a romper."},
    {"t0": 136.72, "t1": 138.84, "texto": "Estás compinchado con el mundo natural, ¿eh?"},
    {"t0": 139.08, "t1": 140.10, "texto": "La madre naturaleza da."},
    {"t0": 140.20, "t1": 141.24, "texto": "Yo solo aumento."}
  ]
