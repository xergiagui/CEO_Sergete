# ============================================================
#  TheLanding · Variables de entorno
#  Copia este archivo a  .env.local  y rellena los valores.
#  (.env.local está en .gitignore: nunca se sube a Git)
# ============================================================

# --- URL pública de tu sitio (sin barra final) ---
# En local: http://localhost:3000 · En producción: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave ANON (pública). Se usa SOLO en el servidor. La seguridad la dan las
# reglas RLS de supabase/policies.sql (anon solo inserta; no lee filas).
SUPABASE_ANON_KEY=eyJhbGci...tu_anon_key...

# --- Contraseña del panel privado de estadísticas (/stats) ---
STATS_PASSWORD=cambia-esta-contrasena

# --- Contacto por email ---
# Email donde recibirás los mensajes (nunca se muestra en la web).
CONTACT_EMAIL=tu-email@ejemplo.com
# API key de Resend (https://resend.com). Opcional: sin ella el mensaje se
# guarda en Supabase (tabla messages) pero no se envía email.
RESEND_API_KEY=
# Remitente del email. Con el dominio de pruebas de Resend usa este valor.
CONTACT_FROM=TheLanding <onboarding@resend.dev>
