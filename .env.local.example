# ============================================================
#  TheLanding · Variables de entorno
#  Copia este archivo a  .env.local  y rellena los valores.
#  (.env.local está en .gitignore: nunca se sube a Git)
# ============================================================

# --- URL pública de tu sitio (sin barra final) ---
# En local: http://localhost:3000 · En producción: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# service_role: clave SECRETA de servidor. NUNCA la pongas con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...tu_service_role...

# --- Contraseña del panel privado de estadísticas (/stats) ---
# Elige una contraseña robusta. Se pide al entrar en /stats.
STATS_PASSWORD=cambia-esta-contrasena
